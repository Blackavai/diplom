# Console launch: copy to backend/.env and enter your existing DB connection values.
# Never commit the resulting .env. This file does not create a DB or users.
PORT=5000
DB_HOST=127.0.0.1
# Use the published PostgreSQL host port here; Docker app uses internal 5432.
DB_PORT=5432
DB_NAME=replace_with_existing_database
DB_USER=replace_with_existing_user
DB_PASSWORD=replace_with_existing_password
JWT_SECRET=replace_with_random_secret
# LEGACY_PASSWORD_LOGIN_UNTIL is intentionally absent; see scripts/README.md.
